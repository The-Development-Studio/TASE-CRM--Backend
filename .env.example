# Backend-only settings. Never prefix secrets with VITE_.
NODE_ENV=development
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=tds_crm
# Usually leave blank. Set comma-separated resolvers only when your host requires custom DNS.
DNS_SERVERS=
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:8443

# Required in production. Bootstrap key is used only to invite the first staff administrator.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STAFF_ADMIN_KEY=replace_me_with_a_random_secret_of_at_least_32_characters

# Create an R2 bucket and an API token with object read/write access.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=tds-crm-documents

# Create these in Resend after verifying your sending domain.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=TDS CRM <crm@example.com>
RESEND_WEBHOOK_SECRET=whsec_replace_me
